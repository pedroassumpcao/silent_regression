{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silentregression.com/schemas/case-import-v1.schema.json",
  "title": "Silent Regression case import v1",
  "description": "A bounded set of representative cases for one immutable monitor version. Case-key and position uniqueness plus the 1–20 active-case limit are enforced by the application.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_key", "name", "input_variables", "frozen_context"],
      "properties": {
        "case_key": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": ["active", "disabled"],
          "default": "active"
        },
        "input_variables": {
          "type": "object"
        },
        "frozen_context": {
          "type": "string"
        }
      }
    }
  }
}
