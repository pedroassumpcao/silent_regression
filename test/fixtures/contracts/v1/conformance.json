{
  "fixture_schema_version": 1,
  "split": "conformance",
  "status": "candidate",
  "contracts": [
    {
      "key": "invoice",
      "contract": {
        "schema_version": 1,
        "contract_id": "fixture-contract-invoice",
        "contract_version": 1,
        "monitor_id": "fixture-monitor-invoice",
        "root": {
          "id": "invoice_contract",
          "type": "all",
          "rules": [
            {"id": "invoice_json", "type": "json_valid"},
            {"id": "invoice_number", "type": "json_path_exists", "path": "/invoice_number"},
            {"id": "currency_type", "type": "json_path_type", "path": "/currency", "expected_type": "string"},
            {"id": "currency_value", "type": "json_path_equals", "path": "/currency", "expected": "USD", "numeric_comparison": "strict"},
            {"id": "invoice_state", "type": "json_path_allowed_values", "path": "/state", "allowed_values": ["approved", "rejected"], "numeric_comparison": "strict"},
            {"id": "invoice_total", "type": "json_path_number", "path": "/total", "minimum": 0, "maximum": 10000}
          ]
        }
      }
    },
    {
      "key": "routing",
      "contract": {
        "schema_version": 1,
        "contract_id": "fixture-contract-routing",
        "contract_version": 1,
        "monitor_id": "fixture-monitor-routing",
        "root": {
          "id": "routing_contract",
          "type": "all",
          "rules": [
            {"id": "routing_label", "type": "classification", "allowed_values": ["approved", "needs review"]},
            {"id": "label_length", "type": "length", "unit": "words", "minimum": 1, "maximum": 2}
          ]
        }
      }
    },
    {
      "key": "retention",
      "contract": {
        "schema_version": 1,
        "contract_id": "fixture-contract-retention",
        "contract_version": 1,
        "monitor_id": "fixture-monitor-retention",
        "root": {
          "id": "retention_contract",
          "type": "all",
          "rules": [
            {"id": "retention_term", "type": "required_text", "alternatives": ["retained for 30 days", "30 day retention"]},
            {"id": "no_indefinite_retention", "type": "forbidden_text", "alternatives": ["retained indefinitely"]},
            {
              "id": "consent_required",
              "type": "not",
              "rule": {"id": "optional_consent_claim", "type": "required_text", "alternatives": ["customer consent is optional"]}
            }
          ]
        }
      }
    },
    {
      "key": "refund_citations",
      "contract": {
        "schema_version": 1,
        "contract_id": "fixture-contract-refund-citations",
        "contract_version": 1,
        "monitor_id": "fixture-monitor-refund-citations",
        "root": {
          "id": "refund_contract",
          "type": "all",
          "rules": [
            {"id": "ledger_source", "type": "required_source_ids", "source_ids": ["ledger-7"]},
            {"id": "known_sources", "type": "allowed_source_ids", "source_ids": ["ledger-7", "approval-2"], "require_at_least_one": true},
            {"id": "approval_source", "type": "fact_citation", "fact_alternatives": ["refund was approved", "approved refund"], "source_ids": ["approval-2"], "max_distance_characters": 80}
          ]
        }
      }
    },
    {
      "key": "shipping_abstention",
      "contract": {
        "schema_version": 1,
        "contract_id": "fixture-contract-shipping-abstention",
        "contract_version": 1,
        "monitor_id": "fixture-monitor-shipping-abstention",
        "root": {
          "id": "abstention_contract",
          "type": "all",
          "rules": [
            {"id": "shipping_abstention", "type": "required_abstention", "alternatives": ["delivery date is not specified", "cannot determine the delivery date"]},
            {"id": "no_invented_delivery", "type": "forbidden_text", "alternatives": ["delivery date is friday", "ships to mars"]}
          ]
        }
      }
    },
    {
      "key": "fulfillment",
      "contract": {
        "schema_version": 1,
        "contract_id": "fixture-contract-fulfillment",
        "contract_version": 1,
        "monitor_id": "fixture-monitor-fulfillment",
        "root": {
          "id": "fulfillment_contract",
          "type": "any",
          "rules": [
            {"id": "delivered", "type": "required_text", "alternatives": ["delivered to customer"]},
            {"id": "collected", "type": "required_text", "alternatives": ["collected at pickup point"]}
          ]
        }
      }
    },
    {
      "key": "deep_json",
      "contract": {
        "schema_version": 1,
        "contract_id": "fixture-contract-deep-json",
        "contract_version": 1,
        "monitor_id": "fixture-monitor-deep-json",
        "root": {"id": "safe_json_depth", "type": "json_valid"}
      }
    }
  ],
