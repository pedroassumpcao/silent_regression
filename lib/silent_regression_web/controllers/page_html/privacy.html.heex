<Layouts.app flash={@flash}>
  <section id="privacy-page" class="py-16 sm:py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center gap-3">
        <span class="rounded-full border border-warning/25 bg-warning/10 px-3 py-1.5 text-xs font-semibold text-warning-foreground">
          Draft—legal review required
        </span>
        <span class="text-sm text-muted-foreground">Private-alpha placeholder · 14 September 2026</span>
      </div>
      <h1 class="mt-6 text-4xl font-semibold tracking-[-0.04em] sm:text-6xl">Privacy notice</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-muted-foreground">
        This plain-language draft describes the narrow public application implemented today. It must be reviewed and replaced or approved by qualified counsel before broader external use.
      </p>

      <div class="mt-12 space-y-10 border-t border-border pt-10 text-base leading-7">
        <section aria-labelledby="privacy-collect">
          <h2 id="privacy-collect" class="text-xl font-semibold">Information collected</h2>
          <p class="mt-3 text-muted-foreground">
            The design-partner application collects your name, work email, company, role, a description of the LLM workflow you want to monitor, the problem you face today, whether you use OpenAI, Anthropic, or both, and whether you can participate in recurring feedback.
          </p>
        </section>

        <section aria-labelledby="privacy-use">
          <h2 id="privacy-use" class="text-xl font-semibold">How it is used</h2>
          <p class="mt-3 text-muted-foreground">
            Application information is used to evaluate product fit, prioritize design-partner conversations, contact applicants about the private alpha, and learn which deterministic monitoring requirements recur across companies. Submitting the form does not create an account or subscription.
          </p>
        </section>

        <section aria-labelledby="privacy-not-collected">
          <h2 id="privacy-not-collected" class="text-xl font-semibold">
            What the public form does not collect
          </h2>
          <p class="mt-3 text-muted-foreground">
            Do not submit provider credentials, production prompts, model outputs, personal customer data, confidential documents, or regulated information through the application form. The form does not request payment information.
          </p>
        </section>

        <section aria-labelledby="privacy-retention">
          <h2 id="privacy-retention" class="text-xl font-semibold">Retention and requests</h2>
          <p class="mt-3 text-muted-foreground">
            Application information will be retained while design-partner evaluation is active and while needed to record the outcome of that evaluation. A verified deletion and withdrawal process is required before the first external pilot. Until a dedicated contact address is published, applicants should use the communication channel through which they received access to this private-alpha site.
          </p>
        </section>

        <section aria-labelledby="privacy-changes">
          <h2 id="privacy-changes" class="text-xl font-semibold">Changes to this draft</h2>
          <p class="mt-3 text-muted-foreground">
            This notice will change as account access, workspace data, credentials, replay captures, and operational providers are implemented. Material data practices must be reflected here before those capabilities are offered externally.
          </p>
        </section>
      </div>
    </div>
  </section>
</Layouts.app>
