<Layouts.app flash={@flash}>
  <section
    id="foundation-home"
    class="overflow-hidden rounded-3xl border border-border bg-card shadow-sm"
  >
    <div class="grid gap-10 px-6 py-10 sm:px-10 sm:py-14 lg:grid-cols-[1.25fr_0.75fr] lg:px-14 lg:py-16">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-primary">
          Foundation checkpoint
        </p>
        <h1 class="mt-4 text-balance text-4xl font-semibold tracking-[-0.035em] text-foreground sm:text-5xl">
          Catch silent failures in critical LLM workflows.
        </h1>
        <p class="mt-5 max-w-xl text-pretty text-base leading-7 text-muted-foreground sm:text-lg">
          Silent Regression replays representative cases and reports the exact user-approved contract that changed.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <.button href={~p"/app"} variant="primary">Open product foundation</.button>
          <span class="text-sm text-muted-foreground">Invite-only alpha · deterministic checks</span>
        </div>
      </div>

      <div class="rounded-2xl border border-border bg-muted/45 p-5 sm:p-6">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">
          Monitoring loop
        </p>
        <ol class="mt-5 space-y-4">
          <li class="flex gap-3">
            <span class="grid size-7 shrink-0 place-items-center rounded-full bg-primary text-xs font-semibold text-primary-foreground">
              1
            </span>
            <span class="pt-0.5 text-sm font-medium">Define a representative workflow</span>
          </li>
          <li class="flex gap-3">
            <span class="grid size-7 shrink-0 place-items-center rounded-full bg-primary text-xs font-semibold text-primary-foreground">
              2
            </span>
            <span class="pt-0.5 text-sm font-medium">Approve deterministic expectations</span>
          </li>
          <li class="flex gap-3">
            <span class="grid size-7 shrink-0 place-items-center rounded-full bg-primary text-xs font-semibold text-primary-foreground">
              3
            </span>
            <span class="pt-0.5 text-sm font-medium">Replay and inspect exact evidence</span>
          </li>
        </ol>
      </div>
    </div>
  </section>
</Layouts.app>
